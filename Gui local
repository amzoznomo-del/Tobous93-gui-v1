-- Helper Functions
local function getHDAdmin()
	local success, rc = pcall(function()
		return ReplicatedStorage:WaitForChild("HDAdminHDClient", 2).Signals.RequestCommandSilent
	end)
	return rc
end

local function getF3XRemote()
	local char = LocalPlayer.Character
	local backpack = LocalPlayer:FindFirstChild("Backpack")
	local tool = (backpack and backpack:FindFirstChild("Building Tools")) or (char and char:FindFirstChild("Building Tools"))
	if tool then
		local endpoint = tool:FindFirstChild("SyncAPI") and tool.SyncAPI:FindFirstChild("ServerEndpoint")
		return endpoint
	end
	return nil
end

-- Check and Auto Get F3X if missing on startup
task.spawn(function()
	task.wait(1)
	local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
	local backpack = LocalPlayer:FindFirstChild("Backpack")
	local hasF3X = (backpack and backpack:FindFirstChild("Building Tools")) or (char and char:FindFirstChild("Building Tools"))
	
	if not hasF3X then
		local rc = getHDAdmin()
		if rc then
			rc:InvokeServer(";Btools")
		end
	end
end)

